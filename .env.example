# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/liferpg?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT Security Configuration
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:5173,https://life-rpg-gamification.netlify.app

# Optional AI API Key (Fallback planner runs seamlessly if unconfigured)
AI_API_KEY=

# Frontend build/deployment variable (set in Netlify, not the backend)
VITE_API_URL=http://localhost:8080
